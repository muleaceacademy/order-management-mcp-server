{
  "transport": {
    "kind": "streamable-http"
  },
  "tools": [
    {
      "name": "get_order_status",
      "description": "Returns the current status of an order using the provided order ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "Unique order identifier, for example ORD-1001.",
            "minLength": 1
          }
        },
        "required": ["orderId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "orderId":     { "type": "string" },
          "status":      { "type": "string" },
          "lastUpdated": { "type": "string" },
          "message":     { "type": "string" }
        },
        "required": ["orderId", "status", "lastUpdated", "message"]
      }
    },
    {
      "name": "get_shipping_eta",
      "description": "Returns the estimated shipping and delivery information for an order using the provided order ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "Unique order identifier, for example ORD-1001.",
            "minLength": 1
          }
        },
        "required": ["orderId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "orderId":               { "type": "string" },
          "shippingStatus":        { "type": "string" },
          "carrier":               { "type": ["string", "null"] },
          "trackingNumber":        { "type": ["string", "null"] },
          "estimatedDeliveryDate": { "type": "string" }
        },
        "required": ["orderId", "shippingStatus", "estimatedDeliveryDate"]
      }
    },
    {
      "name": "search_orders",
      "description": "Search orders using optional filter criteria such as status, customerId, orderDate range (dateFrom / dateTo). Returns a list of matching order summaries. All parameters are optional; omitting all returns all orders.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Filter by order status. Valid values: PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED.",
            "enum": ["PENDING", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"]
          },
          "customerId": {
            "type": "string",
            "description": "Filter by customer ID, for example CUST-101."
          },
          "dateFrom": {
            "type": "string",
            "description": "Return orders placed on or after this date (inclusive). Format: YYYY-MM-DD."
          },
          "dateTo": {
            "type": "string",
            "description": "Return orders placed on or before this date (inclusive). Format: YYYY-MM-DD."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "totalResults": { "type": "number" },
          "orders": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "orderId":    { "type": "string" },
                "customerId": { "type": "string" },
                "status":     { "type": "string" },
                "orderDate":  { "type": "string" },
                "orderTotal": { "type": "number" }
              }
            }
          }
        },
        "required": ["totalResults", "orders"]
      }
    },
    {
      "name": "customer_lookup",
      "description": "Look up a customer record by customerId (e.g. CUST-101) or email address. Supply exactly one of the two parameters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "description": "Unique customer identifier, for example CUST-101."
          },
          "email": {
            "type": "string",
            "description": "Customer email address, for example alice.johnson@example.com."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "customerId":  { "type": "string" },
          "name":        { "type": "string" },
          "email":       { "type": "string" },
          "phone":       { "type": "string" },
          "address": {
            "type": "object",
            "properties": {
              "street":  { "type": "string" },
              "city":    { "type": "string" },
              "state":   { "type": "string" },
              "zip":     { "type": "string" },
              "country": { "type": "string" }
            }
          },
          "tier":        { "type": "string" },
          "totalOrders": { "type": "number" },
          "createdAt":   { "type": "string" }
        },
        "required": ["customerId", "name", "email", "tier"]
      }
    },
    {
      "name": "create_invoice",
      "description": "Retrieve or generate an invoice for an order. Returns the invoice ID, status, line items, subtotal, tax, and total amount for the specified order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "Unique order identifier for which to retrieve or create an invoice, for example ORD-1001.",
            "minLength": 1
          }
        },
        "required": ["orderId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "invoiceId":   { "type": "string" },
          "orderId":     { "type": "string" },
          "customerId":  { "type": "string" },
          "invoiceDate": { "type": "string" },
          "dueDate":     { "type": "string" },
          "status":      { "type": "string" },
          "currency":    { "type": "string" },
          "subtotal":    { "type": "number" },
          "taxRate":     { "type": "number" },
          "taxAmount":   { "type": "number" },
          "total":       { "type": "number" },
          "lineItems": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku":         { "type": "string" },
                "description": { "type": "string" },
                "qty":         { "type": "number" },
                "unitPrice":   { "type": "number" },
                "lineTotal":   { "type": "number" }
              }
            }
          }
        },
        "required": ["invoiceId", "orderId", "status", "total", "lineItems"]
      }
    },
    {
      "name": "track_shipment",
      "description": "Track a shipment and retrieve carrier details, current status, tracking milestones, and estimated delivery date. Supply either trackingNumber or orderId — at least one is required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "trackingNumber": {
            "type": "string",
            "description": "Carrier tracking number, for example BD784512963IN."
          },
          "orderId": {
            "type": "string",
            "description": "Unique order identifier, for example ORD-1002.",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "orderId":               { "type": "string" },
          "trackingNumber":        { "type": ["string", "null"] },
          "carrier":               { "type": ["string", "null"] },
          "shippingStatus":        { "type": "string" },
          "estimatedDeliveryDate": { "type": ["string", "null"] },
          "milestones": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "event":     { "type": "string" },
                "location":  { "type": "string" },
                "timestamp": { "type": "string" }
              }
            }
          }
        },
        "required": ["orderId", "shippingStatus"]
      }
    },
    {
      "name": "get_payment_status",
      "description": "Get the payment status and details for an order. Supply either orderId or paymentId — at least one is required. Returns payment method, transaction ID, amount, currency, and current status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "Unique order identifier, for example ORD-1001."
          },
          "paymentId": {
            "type": "string",
            "description": "Unique payment identifier, for example PAY-3001."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "paymentId":     { "type": "string" },
          "orderId":       { "type": "string" },
          "customerId":    { "type": "string" },
          "paymentMethod": { "type": "string" },
          "cardLast4":     { "type": ["string", "null"] },
          "paymentStatus": { "type": "string" },
          "amount":        { "type": "number" },
          "currency":      { "type": "string" },
          "paymentDate":   { "type": ["string", "null"] },
          "transactionId": { "type": ["string", "null"] }
        },
        "required": ["paymentId", "orderId", "paymentStatus", "amount"]
      }
    },
    {
      "name": "process_refund",
      "description": "Process a refund request for an order or retrieve an existing refund record. Provide the orderId and an optional reason. Returns refund ID, status, amount, and timestamps.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "Unique order identifier for which to request or retrieve a refund, for example ORD-1003.",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "description": "Reason for the refund request, for example 'Item damaged on arrival'."
          },
          "amount": {
            "type": "number",
            "description": "Refund amount in USD. If omitted, the full order total is refunded."
          }
        },
        "required": ["orderId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "refundId":     { "type": "string" },
          "orderId":      { "type": "string" },
          "paymentId":    { "type": ["string", "null"] },
          "customerId":   { "type": "string" },
          "refundAmount": { "type": "number" },
          "currency":     { "type": "string" },
          "reason":       { "type": "string" },
          "status":       { "type": "string" },
          "requestedAt":  { "type": "string" },
          "processedAt":  { "type": ["string", "null"] }
        },
        "required": ["refundId", "orderId", "refundAmount", "status", "requestedAt"]
      }
    },
    {
      "name": "get_order_details",
      "description": "Returns the complete, unfiltered details for an order including full customer profile (address duplicated 6 ways, name repeated 8 ways), all product specifications, embedded HTML marketing content, base64-encoded product images, internal ERP/CRM/warehouse IDs, null placeholder fields, verbose audit history, order totals duplicated in 4 structures, and unrelated recommendations. NOTE: Intentionally returns a large unoptimized payload (~15 KB) to demonstrate the MuleSoft Payload Optimization policy for LLM token-cost reduction.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "Unique order identifier, for example ORD-1001.",
            "minLength": 1
          }
        },
        "required": ["orderId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "description": "Unoptimized full order detail payload — customer, items, HTML, base64, repeated keys, nulls, audit log, metadata.",
        "properties": {
          "orderId":         { "type": "string" },
          "status":          { "type": "string" },
          "customer":        { "type": "object" },
          "items":           { "type": "array"  },
          "shipping":        { "type": "object" },
          "shippingDetails": { "type": "object" },
          "payment":         { "type": "object" },
          "totals":          { "type": "object" },
          "summary":         { "type": "object" },
          "auditLog":        { "type": "array"  },
          "recommendations": { "type": "array"  },
          "_metadata":       { "type": "object" }
        },
        "required": ["orderId", "status", "customer", "items"]
      }
    },
    {
      "name": "check_inventory",
      "description": "Check the current inventory stock level for a product SKU. Returns available quantity, warehouse location, reorder level, and stock status (IN_STOCK, LOW_STOCK, OUT_OF_STOCK).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "Product SKU identifier, for example SKU-A100.",
            "minLength": 1
          }
        },
        "required": ["sku"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "sku":               { "type": "string" },
          "name":              { "type": "string" },
          "category":          { "type": "string" },
          "stockQuantity":     { "type": "number" },
          "reservedQuantity":  { "type": "number" },
          "availableQuantity": { "type": "number" },
          "warehouseLocation": { "type": "string" },
          "reorderLevel":      { "type": "number" },
          "unitPrice":         { "type": "number" },
          "status":            { "type": "string" }
        },
        "required": ["sku", "name", "availableQuantity", "status"]
      }
    }
  ]
}
