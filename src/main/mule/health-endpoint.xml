<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
          http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http
          http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core
          http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!--
        Health Check Flow
        Responds to GET /health with HTTP 200 and a JSON status document.
        Used by container orchestration, monitoring tools, and MCP Inspector
        to verify the application is running before sending MCP requests.
    -->
    <flow name="health-check-flow"
          doc:name="Health Check Flow"
          doc:description="Returns HTTP 200 with application status for health monitoring">

        <http:listener
            config-ref="HTTP_Listener_Config"
            path="/health"
            allowedMethods="GET"
            doc:name="GET /health"
            doc:description="Listens for GET /health requests from health monitors and readiness probes"/>

        <ee:transform
            doc:name="Build Health Response"
            doc:description="Constructs the JSON health response with application name and UP status">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    application: "order-management-mcp-server",
    status: "UP"
}]]></ee:set-payload>
            </ee:message>
            <ee:variables>
                <ee:set-variable variableName="httpStatus"><![CDATA[200]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

    </flow>

</mule>